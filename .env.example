# Required
OPENAI_API_KEY=sk-...
APP_PIN=replace-with-a-long-private-pin
SESSION_SECRET=replace-with-a-random-64-character-secret
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional: enables attempts on age-restricted, members-only, private or login-required
# YouTube videos that the cookie-owning account is authorized to view.
# Store the full Cookie request header string, e.g. SID=...; HSID=...; ...
YOUTUBE_COOKIE=

# Model defaults. Change later without code edits.
OPENAI_SUMMARY_MODEL=gpt-5-mini
OPENAI_CLASSIFIER_MODEL=gpt-5-nano
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
